# EFPT_AMS Environment Configuration
# Copy this file to .env and update with your settings

# ─── Database Configuration ───
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=efpt_ams

# ─── Application URL (optional; auto-detected if not set) ───
# SITE_URL=http://localhost/EFPT_AMS
# Base URL encoded in voucher QR codes. For phone scans when vouchers are
# printed from a localhost session, set this to the server's reachable LAN URL.
# QR_VERIFICATION_BASE_URL=http://192.168.1.10/EFPT_AMS

# ─── AI Assistant (optional; server-side OpenAI-compatible HTTPS endpoint) ───
# To configure:
# 1. Sign up at https://platform.openai.com (or use any OpenAI-compatible provider)
# 2. Get an API key (format: sk-...)
# 3. Paste it below: AI_CHAT_API_KEY=sk-your-key-here
# 4. Reload the page — no server restart needed
# Leave empty to keep AI chat unavailable.
AI_CHAT_API_KEY=
AI_CHAT_API_URL=https://api.openai.com/v1/chat/completions
AI_CHAT_MODEL=gpt-4o-mini

# ─── HR System Integration API ───
# API key for the HR integration REST endpoint (admin/hr_integration.php).
# Generate a secure random key (e.g. `php -r "echo bin2hex(random_bytes(32));"`)
# and share it with the HR system for authentication on every request.
# Leave empty to disable the HR integration API.
HR_INTEGRATION_API_KEY=

# ─── Default Admin Credentials (optional override) ───
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD_HASH=

# ─── Notes ───
# The following settings are defined in includes/config.php with proper types
# and do NOT need to be in .env (boolean 'false' strings are truthy in PHP):
#   - ENABLE_SCHEMA_MIGRATIONS (bool, default: false)
#   - SESSION_TIMEOUT (int, seconds, default: 3600)
#   - MAX_LOGIN_ATTEMPTS (int, default: 4)
#   - LOGIN_LOCKOUT_MINUTES (int, default: 5)
#   - MIN_PASSWORD_LENGTH (int, default: 8)
#   - PASSWORD_REQUIRE_UPPER/LOWER/DIGIT/SPECIAL (bool, default: true)
#   - ENABLE_SECURITY_HEADERS (bool, default: true)
#   - CSP_* (string, various defaults)
# To override these, edit includes/config.php directly.
